{
  "name": "green-fork-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx --test test/app.test.ts test/socialAuth.test.ts",
    "test:postgres": "tsx --test test/postgres.integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "cookie": "1.0.2"
  }
}
